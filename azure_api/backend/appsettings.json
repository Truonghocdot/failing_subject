{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "expense-api",
    "Audience": "expense-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "RefreshCookieSecure": true
  },
  "App": {
    "TimeZone": "Asia/Ho_Chi_Minh"
  },
  "RateLimit": {
    "AuthPermitPerMinute": 10
  }
}
