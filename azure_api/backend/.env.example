# Copy file này thành .env rồi điền giá trị thật:  cp .env.example .env
# Quy ước: dấu "__" (2 gạch dưới) = cấp lồng trong appsettings.json
#   VD: Jwt__Secret  <=>  { "Jwt": { "Secret": "..." } }

# Bản publish / Windows Service: đặt file này cạnh backend.exe với ASPNETCORE_ENVIRONMENT=Production,
# Jwt__Secret mới (khác bản dev) – xem docs/07-van-hanh.md

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5090

# --- MySQL (localhost:3306) – tạo DB + user: docs/06-database.md §2 ---
ConnectionStrings__Default=Server=localhost;Port=3306;Database=expense;User=expense;Password=change_me;CharSet=utf8mb4

# --- JWT ---
# Secret tối thiểu 32 ký tự. Tạo nhanh: openssl rand -base64 48
Jwt__Issuer=expense-api
Jwt__Audience=expense-web
Jwt__Secret=change_me_to_a_random_string_at_least_32_chars
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30
# true khi chạy HTTPS (cookie refresh chỉ gửi qua HTTPS); http://localhost vẫn chạy được với true, http://<IP LAN> thì không
Jwt__RefreshCookieSecure=false

# --- Chống dò mật khẩu: số request /api/auth/* mỗi phút / IP ---
RateLimit__AuthPermitPerMinute=10

# Múi giờ để tính "hôm nay" / "tháng này" (IANA)
App__TimeZone=Asia/Ho_Chi_Minh

# --- CORS: chỉ cần khi FE chạy ở origin khác backend (thêm __1, __2... nếu nhiều) ---
# Cors__AllowedOrigins__0=http://localhost:5173
