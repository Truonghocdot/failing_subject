# Copy thành .env:  cp .env.example .env
# Chạy app:  flutter run --dart-define-from-file=.env
# Đọc trong code: String.fromEnvironment('API_BASE_URL')
# LƯU Ý: mọi giá trị ở đây được nhúng vào file APK -> KHÔNG đặt secret.

# Android emulator: http://10.0.2.2:5080 | iOS simulator: http://localhost:5080 | Máy thật: http://<IP-máy-tính>:5080
API_BASE_URL=http://10.0.2.2:5080
API_TIMEOUT_SECONDS=15

# Domain trình phát nhúng được phép điều hướng trong WebView
PLAYER_ALLOWED_HOST_SUFFIX=streamvsmov.com
