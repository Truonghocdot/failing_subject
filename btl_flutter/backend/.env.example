# Copy file này thành .env rồi điền giá trị thật:  cp .env.example .env
# Quy ước: dấu "__" (2 gạch dưới) = cấp lồng trong appsettings.json
#   VD: Jwt__Secret  <=>  { "Jwt": { "Secret": "..." } }

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5080

# --- MySQL (localhost:3306) ---
# Tạo DB + user riêng (chạy bằng tài khoản root):
#   CREATE DATABASE vsmovie CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'vsmovie'@'%' IDENTIFIED BY '<mật khẩu>';
#   GRANT ALL PRIVILEGES ON vsmovie.* TO 'vsmovie'@'%';
ConnectionStrings__Default=Server=localhost;Port=3306;Database=vsmovie;User=vsmovie;Password=change_me;CharSet=utf8mb4

# --- JWT ---
# Secret tối thiểu 32 ký tự. Tạo nhanh: python -c "import secrets;print(secrets.token_urlsafe(48))"
Jwt__Issuer=vsmovie-api
Jwt__Audience=vsmovie-app
Jwt__Secret=change_me_to_a_random_string_at_least_32_chars
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=30

# --- Nguồn phim vsmov ---
Vsmov__BaseUrl=https://vsmov.com/api/
Vsmov__TimeoutSeconds=10

# --- CORS (thêm __1, __2... nếu nhiều origin) ---
Cors__AllowedOrigins__0=*
