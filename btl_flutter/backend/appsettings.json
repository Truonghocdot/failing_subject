{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Vsmov": {
    "BaseUrl": "https://vsmov.com/api/",
    "TimeoutSeconds": 10
  },
  "Jwt": {
    "Issuer": "vsmovie-api",
    "Audience": "vsmovie-app",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 30
  },
  "Cors": {
    "AllowedOrigins": [ "*" ]
  }
}
