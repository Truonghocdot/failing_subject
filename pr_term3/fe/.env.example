# Copy thành .env:  cp .env.example .env
# Biến VITE_* được NHÚNG vào bundle trình duyệt → không bao giờ đặt bí mật ở đây.

VITE_APP_NAME=Homestay Booking
# Để /api khi chạy qua proxy Vite (dev) hoặc khi backend phục vụ luôn fe/dist (release)
VITE_API_BASE_URL=/api

# Chỉ vite.config.ts đọc (không có tiền tố VITE_) – địa chỉ backend cho proxy của `npm run dev`
API_PROXY_TARGET=http://localhost:5100
