# Copy file này thành .env rồi điền giá trị thật:  cp .env.example .env
# Quy ước: dấu "__" (2 gạch dưới) = cấp lồng trong appsettings.json
#   VD: Jwt__Secret  <=>  { "Jwt": { "Secret": "..." } }

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5100

# --- MySQL (localhost:3306) – tạo DB + user: docs/06-database.md §2 ---
ConnectionStrings__Default=Server=localhost;Port=3306;Database=homestay;User=homestay;Password=change_me;CharSet=utf8mb4

# --- JWT (Phase 1) ---
# Secret tối thiểu 32 ký tự. Tạo nhanh: openssl rand -base64 48
Jwt__Issuer=homestay-api
Jwt__Audience=homestay-web
Jwt__Secret=change_me_to_a_random_string_at_least_32_chars
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30
# true khi chạy HTTPS (cookie refresh chỉ gửi qua HTTPS)
Jwt__RefreshCookieSecure=false

# --- Admin đầu tiên (tạo lúc khởi động khi DB chưa có admin nào; mật khẩu ≥ 8 ký tự) ---
Seed__AdminEmail=admin@homestay.local
Seed__AdminPassword=change_me_admin
# Thêm 2 homestay + 5 phòng mẫu khi DB chưa có homestay (Development bật sẵn trong appsettings.Development.json)
# Seed__SampleData=true

# Múi giờ để tính "hôm nay", hạn giữ chỗ, chính sách huỷ (IANA)
App__TimeZone=Asia/Ho_Chi_Minh
# Link trong email gửi khách
App__PublicBaseUrl=http://localhost:5174

# --- Chống dò mật khẩu: số request đăng nhập / đăng ký / tra cứu mỗi phút / IP ---
RateLimit__AuthPermitPerMinute=10
